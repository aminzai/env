# Reuse one agent across interactive Bash and Zsh sessions.  Starting a new
# agent in every shell leaves orphan processes and repeatedly reloads the key.
_ssh_agent_usable() {
  ssh-add -l >/dev/null 2>&1
  [ "$?" -ne 2 ]
}

_ensure_ssh_agent() {
  command -v ssh-agent >/dev/null 2>&1 || return
  command -v ssh-add >/dev/null 2>&1 || return

  if _ssh_agent_usable; then
    return
  fi

  _ssh_agent_dir="${XDG_RUNTIME_DIR:-}"
  if [ -z "$_ssh_agent_dir" ] || [ ! -d "$_ssh_agent_dir" ] || [ ! -w "$_ssh_agent_dir" ]; then
    _ssh_agent_dir="$HOME/.cache"
  fi
  if ! mkdir -p "$_ssh_agent_dir" 2>/dev/null || [ ! -w "$_ssh_agent_dir" ]; then
    return
  fi
  _ssh_agent_env="$_ssh_agent_dir/ssh-agent.env"
  if [ -r "$_ssh_agent_env" ]; then
    . "$_ssh_agent_env"
  fi

  if ! _ssh_agent_usable; then
    umask 077
    _ssh_agent_output=$(ssh-agent -s 2>/dev/null) || return
    printf '%s\n' "$_ssh_agent_output" | sed '/^echo /d' > "$_ssh_agent_env" || return
    . "$_ssh_agent_env"
  fi

  ssh-add -l >/dev/null 2>&1
  if [ "$?" -eq 1 ] && [ -f "$HOME/.ssh/desktop_rsa" ]; then
    ssh-add "$HOME/.ssh/desktop_rsa"
  fi
}

case $- in
  *i*) _ensure_ssh_agent ;;
esac




