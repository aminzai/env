
if [ -z "${DOTFILES_ROOT:-}" ] || [ ! -r "$DOTFILES_ROOT/shell/colors" ]; then
  echo "error: DOTFILES_ROOT does not point to a readable dotfiles checkout" >&2
  return 1
fi

. "$DOTFILES_ROOT/shell/colors"

# Machine-local credentials and overrides. This file is deliberately ignored
# by Git and stored outside the checkout.
DOTFILES_CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}
if [ -r "$DOTFILES_CONFIG_HOME/env/private.sh" ]; then
  . "$DOTFILES_CONFIG_HOME/env/private.sh"
fi
unset DOTFILES_CONFIG_HOME

